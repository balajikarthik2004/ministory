# MiniDrama — local infrastructure environment (repository root).
#
# This file configures docker-compose.yml ONLY. The API has its own file at
# apps/backend/.env — two files because Compose substitutes ${VAR} from the
# .env sitting next to the compose file, and the API's variables have no
# business being handed to a database container.
#
#   cp .env.example .env
#
# .env is gitignored. Placeholders only in this file — never a real credential,
# not even a development one, because this file IS committed.

# ───────────────────────── Local PostgreSQL ─────────────────────────
POSTGRES_USER=minidrama
POSTGRES_DB=minidrama

# Choose any value. It is local-only (the port is bound to 127.0.0.1), but it
# must match the password in apps/backend/.env DATABASE_URL.
POSTGRES_PASSWORD=change_me_locally

# Host port. Change it if something already owns 5432 — a system Postgres, or
# another project's container.
POSTGRES_PORT=5432
