# MiniDrama Mobile - example environment file.
# Copy to .env and adjust. Only EXPO_PUBLIC_-prefixed variables are readable
# by the app at runtime.
#
# WARNING: EXPO_PUBLIC_ values are embedded in the JavaScript bundle and can be
# extracted from a shipped APK. They are public. No API key, signing secret or
# credential belongs here (CLAUDE.md §11: never expose secrets in the mobile app).

# Android emulator reaches the host machine at 10.0.2.2.
# A physical device needs your machine's LAN IP - see README.md.
EXPO_PUBLIC_API_BASE_URL=http://10.0.2.2:4000/api/v1

# Local HLS fixture server (tools/video-fixtures/serve.mjs), used by the M2.1
# player while the real streaming backend does not exist.
#
# The default assumes a USB tunnel:  adb reverse tcp:8787 tcp:8787
# That avoids Wi-Fi and the firewall entirely, so a failed load means the
# fixture server is down rather than the LAN address having moved.
# Without adb reverse, set your machine's LAN IP - serve.mjs prints it.
EXPO_PUBLIC_FIXTURE_BASE_URL=http://127.0.0.1:8787

# Makes every mock data request fail, so the error and retry states can be
# exercised without unplugging anything. Also toggleable from the Profile
# screen in a development build.
EXPO_PUBLIC_MOCK_FAILURES=false

# ───────────────────────────── API (M2.3) ─────────────────────────────
# 'live' talks to the Express backend; 'mock' uses the in-memory M2.1
# catalogue so UI work needs no database. Both are supported.
EXPO_PUBLIC_API_MODE=live

# A physical device cannot reach your laptop on 'localhost'. Two options:
#   adb reverse tcp:4000 tcp:4000   -> then use 127.0.0.1 below (USB, no Wi-Fi)
#   your machine's LAN IP           -> `ipconfig | findstr IPv4`, same Wi-Fi,
#                                      and allow port 4000 through the firewall
EXPO_PUBLIC_API_BASE_URL=http://127.0.0.1:4000/api/v1

# ──────────────────── Authentication (M2.5) ────────────────────
# There is deliberately NO credential here any more.
#
# EXPO_PUBLIC_DEV_AUTH_TOKEN was removed in M2.5. Every EXPO_PUBLIC_ value is
# compiled into the JavaScript bundle and can be extracted from a shipped APK
# with a zip tool and a text editor, so a credential in this file ships to
# every user — disabled or not.
#
# The app now authenticates with a real session: a short-lived access token in
# memory, backed by a refresh token in the device keystore (expo-secure-store).
# On first launch it asks the backend for a guest session, so browsing and
# watch history work before anyone signs in.
#
# Nothing secret may be added to this file.
