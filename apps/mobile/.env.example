# MiniDrama Mobile - example environment file.
# Copy to .env and adjust. Only EXPO_PUBLIC_-prefixed variables are readable
# by the app at runtime.
#
# WARNING: EXPO_PUBLIC_ values are embedded in the JavaScript bundle and can be
# extracted from a shipped APK. They are public. No API key, signing secret or
# credential belongs here (CLAUDE.md §11: never expose secrets in the mobile app).

# Android emulator reaches the host machine at 10.0.2.2.
# A physical device needs your machine's LAN IP - see README.md.
EXPO_PUBLIC_API_BASE_URL=http://10.0.2.2:4000/api/v1
