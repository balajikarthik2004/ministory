{
  /* The app itself.

     `tests/` is deliberately excluded and typechecked separately by
     tsconfig.tests.json. The tests need Node's types; the app must not have
     them. With `node` in `types` here, `import { readFileSync } from
     'node:fs'` inside a component would typecheck cleanly and then crash on
     a device, which is the worst possible place to find out. */
  "extends": ["expo/tsconfig.base", "../../tsconfig.base.json"],
  "compilerOptions": {
    "lib": ["ES2022", "DOM"],
    "jsx": "react-jsx",
    "noEmit": true,
    "paths": {
      "@/*": ["./*"]
    }
  },
  "include": ["**/*.ts", "**/*.tsx", ".expo/types/**/*.ts", "expo-env.d.ts"],
  "exclude": ["node_modules", ".expo", "dist", "tests"]
}
