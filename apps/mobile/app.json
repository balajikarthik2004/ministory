{
  "expo": {
    "name": "MiniDrama",
    "slug": "minidrama",
    "version": "0.1.0",
    "scheme": "minidrama",
    "platforms": ["android", "ios"],
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#090A0F",
    "newArchEnabled": true,
    "android": {
      "package": "app.minidrama.mobile",
      "edgeToEdgeEnabled": true
    },
    "ios": {
      "bundleIdentifier": "app.minidrama.mobile",
      "supportsTablet": false
    },
    "plugins": ["expo-router"],
    "experiments": {
      "typedRoutes": true
    }
  }
}
