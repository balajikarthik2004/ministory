{
  "name": "@minidrama/mobile",
  "version": "0.1.0",
  "private": true,
  "description": "MiniDrama mobile app (Expo + React Native + TypeScript)",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "start:clear": "expo start --clear",
    "android": "expo start --android",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.tests.json --noEmit",
    "verify:mocks": "node --experimental-strip-types --import ../../tools/node-ts-resolver.mjs ../../tools/verify-mock-catalogue.mjs",
    "test": "node --experimental-transform-types --disable-warning=ExperimentalWarning --import ../../tools/node-ts-resolver.mjs --test \"tests/**/*.test.ts\"",
    "test:watch": "node --experimental-transform-types --disable-warning=ExperimentalWarning --import ../../tools/node-ts-resolver.mjs --test --watch \"tests/**/*.test.ts\"",
    "lint": "eslint .",
    "doctor": "expo-doctor",
    "deps:check": "expo install --check",
    "export:android": "expo export --platform android --output-dir .expo-export",
    "clean": "rimraf .expo .turbo node_modules/.cache"
  },
  "dependencies": {
    "@expo/metro-runtime": "58.0.17",
    "@expo/vector-icons": "15.1.1",
    "@minidrama/contracts": "workspace:*",
    "@minidrama/ui-tokens": "workspace:*",
    "@tanstack/react-query": "5.107.1",
    "expo": "58.0.25",
    "expo-constants": "58.0.16",
    "expo-crypto": "58.0.8",
    "expo-linking": "58.0.17",
    "expo-network": "58.0.5",
    "expo-router": "58.0.31",
    "expo-secure-store": "~58.0.3",
    "expo-sqlite": "58.0.17",
    "expo-status-bar": "58.0.5",
    "expo-system-ui": "58.0.7",
    "expo-video": "~58.0.14",
    "react": "19.3.0",
    "react-native": "0.88.1",
    "react-native-safe-area-context": "5.11.1",
    "react-native-screens": "4.30.1",
    "zustand": "5.1.0"
  },
  "devDependencies": {
    "@minidrama/config": "workspace:*",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "eslint": "10.15.0",
    "rimraf": "6.1.4",
    "typescript": "6.0.3"
  }
}
