{
  "name": "@minidrama/admin",
  "version": "0.1.0",
  "private": true,
  "description": "MiniDrama admin dashboard (React + Vite + TypeScript + Tailwind)",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.json --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "clean": "rimraf dist .turbo node_modules/.vite"
  },
  "dependencies": {
    "@minidrama/contracts": "workspace:*",
    "@minidrama/ui-tokens": "workspace:*",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@minidrama/config": "workspace:*",
    "@tailwindcss/vite": "4.3.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "eslint": "10.15.0",
    "rimraf": "6.1.4",
    "tailwindcss": "4.3.5",
    "typescript": "6.0.3",
    "vite": "8.3.8"
  }
}
