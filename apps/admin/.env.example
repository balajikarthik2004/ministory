# MiniDrama Admin - example environment file.
# Copy to .env.local and adjust. Only VITE_-prefixed variables reach the browser.
#
# WARNING: anything here is public. It ships in the JavaScript bundle and is
# readable by anyone who opens the dashboard. Never put a secret, API key or
# signing credential in this file (CLAUDE.md §11).

VITE_API_BASE_URL=http://localhost:4000/api/v1
