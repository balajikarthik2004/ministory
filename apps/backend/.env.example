# MiniDrama API - example environment file.
# Copy to .env and fill in. .env is gitignored and must never be committed.
# Every variable here is validated at boot by src/config/env.ts; the process
# refuses to start if one is missing or malformed.

# ─────────────────────────────── Runtime ───────────────────────────────
NODE_ENV=development
PORT=4000
HOST=0.0.0.0
LOG_LEVEL=debug

# Comma-separated origins allowed to call the API from a browser.
# The mobile app sends no Origin header and is unaffected.
CORS_ORIGINS=http://localhost:5173

# ─────────────────────────────── Database ──────────────────────────────
# Local PostgreSQL from docker-compose.yml at the repository root
# (CLAUDE.md §18, free-first). Required since M1.3 - the API refuses to
# boot without it.
#
# The user, password and database must match the root .env, and the port
# must match POSTGRES_PORT there. Use 5432 unless something already owns
# it locally, which is common where a native PostgreSQL is installed.
DATABASE_URL=postgresql://minidrama:change_me_locally@localhost:5432/minidrama?schema=public

# ───────────────────── Authentication (M2.5) ───────────────────────────
# Signing key for access tokens (HS256). REQUIRED IN EVERY ENVIRONMENT,
# including development — there is no default, because a default here would
# be a published signing key: anyone who read the repository could mint a
# token for any user id.
#
# Generate one:   openssl rand -base64 48
# (or)            node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
AUTH_JWT_SECRET=

# Token lifetimes. The defaults are the ones ARCH §6 specifies; override only
# with a reason.
# AUTH_ACCESS_TTL_SEC=900          # 15 minutes
# AUTH_REFRESH_TTL_DAYS=60         # rotates on every use, reuse is detected
# AUTH_RESET_TTL_MIN=30
# AUTH_VERIFY_TTL_HOURS=24

# `iss` and `aud`, validated on every token. The audience is what will stop a
# consumer token ever authenticating an admin route in M5.
# AUTH_TOKEN_ISSUER=minidrama-api
# AUTH_TOKEN_AUDIENCE=minidrama-mobile

# Credential rate limits, per 15-minute window.
# AUTH_LOGIN_RATE_MAX=10           # per (source address + email)
# AUTH_REGISTER_RATE_MAX=5
# AUTH_RECOVERY_RATE_MAX=5         # forgot-password
# AUTH_TOKEN_RATE_MAX=30           # reset/verify: no email to key on
# AUTH_GUEST_RATE_MAX=5            # per install
# AUTH_GUEST_IP_RATE_MAX=60        # per source address
# AUTH_SENSITIVE_RATE_MAX=5        # change-password + account deletion, per USER id

# ───────────────────── Account deletion (M2.6) ─────────────────────
# How long a deletion receipt stays resolvable. A receipt is what lets a
# client that lost the response ask whether its deletion actually happened,
# after the credential that would have asked has been destroyed.
# AUTH_DELETION_RECEIPT_TTL_DAYS=30
# ACCOUNT_DELETION_AUDIT_RETENTION_DAYS=730   # matches AdminAuditLog in §6
#
# Both are enforced by:  pnpm --filter @minidrama/backend reconcile:deletions -- --prune

# ──────────────────────────── Mail (M2.5) ──────────────────────────────
# `file` writes every message to MAIL_OUTBOX_DIR instead of sending it. It is
# the approved development delivery method: no transactional mail service can
# be used without creating an external account, which CLAUDE.md §18 defers.
#
# Read a password-reset or confirmation link out of apps/backend/.mail-outbox/.
# That directory is gitignored — each file holds a live single-use token.
#
# In production this provider makes /auth/forgot-password answer 503 rather
# than promise an email that goes nowhere. A real sender is a new class behind
# `MailProvider` and needs approval first.
MAIL_PROVIDER=file
# MAIL_OUTBOX_DIR=./.mail-outbox
# MAIL_FROM=MiniDrama <no-reply@minidrama.local>

# Base for links inside emails. A deep link into the app, so a reset link
# opens the reset screen rather than a website that does not exist yet.
# AUTH_LINK_BASE_URL=minidrama://auth

# ───────────────────── Development identity (M2.3) ─────────────────────
# LOCAL DEVELOPMENT ONLY. Replaced by real authentication in M2.5.
#
# The development identity provider verifies NO credential: whoever presents
# DEV_AUTH_TOKEN becomes DEV_AUTH_USER_ID. That is acceptable on a laptop and
# nowhere else, so it is guarded four ways:
#
#   1. DEV_AUTH_ENABLED must be explicitly 'true'.
#   2. The process REFUSES TO START if this is true with NODE_ENV=production.
#   3. The provider's constructor throws if built in production.
#   4. An empty DEV_AUTH_TOKEN leaves the null provider in place, which
#      returns 401 from every protected route.
#
# Generate a token with:  node -e "console.log('dev_'+require('crypto').randomBytes(16).toString('hex'))"
DEV_AUTH_ENABLED=true
DEV_AUTH_TOKEN=
# The seeded user from prisma/seed.ts.
DEV_AUTH_USER_ID=user_seed_test

# Where client-visible asset URLs point. No object storage exists yet
# (CLAUDE.md §19 — R2 is deferred), so this is the scheme the mobile app
# resolves to bundled placeholder artwork. M4 replaces it with a CDN origin.
ASSET_BASE_URL=minidrama-asset://

# Server-side cap on a playback event batch, checked against the parsed array
# and independent of the 100kb body limit.
PLAYBACK_EVENT_MAX_BATCH=100

# Rate limit for POST /playback/events, per caller per window.
#
# Sized so legitimate offline sync never trips it: 120 requests against
# batches of 100 is 12,000 events per minute from one viewer, where an hour
# of continuous playback generates roughly 240 heartbeats. The limit bounds
# an abusive or looping client, not honest traffic. Counted per process —
# see ADR-34 before running more than one instance.
PLAYBACK_EVENT_RATE_WINDOW_MS=60000
PLAYBACK_EVENT_RATE_MAX=120

# How long raw playback events are kept (ARCH §8, DATABASE_SCHEMA §6).
# Enforced by `pnpm --filter @minidrama/backend retention:events`, which is
# invoked manually; add `-- --dry-run` to count without deleting.
PLAYBACK_EVENT_RETENTION_DAYS=90

# ──────────────────────── Deferred integrations ────────────────────────
# Not configured in Milestone 1.1. Listed so the shape is known in advance.
# Each stays behind a provider interface (CLAUDE.md §18) so the local
# free implementation and the paid production one are interchangeable.
#
# Storage (M3)   - local filesystem in development
# STORAGE_PROVIDER=local
# STORAGE_LOCAL_PATH=./storage
#
# Video (M4)     - FFmpeg + locally generated HLS in development
# VIDEO_PROVIDER=local
# FFMPEG_PATH=ffmpeg
