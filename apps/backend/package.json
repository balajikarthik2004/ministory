{
  "name": "@minidrama/backend",
  "version": "0.1.0",
  "private": true,
  "description": "MiniDrama API - modular monolith (Node.js + Express + TypeScript)",
  "type": "module",
  "main": "./dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "clean": "rimraf dist .turbo"
  },
  "dependencies": {
    "@minidrama/contracts": "workspace:*",
    "cors": "2.8.6",
    "express": "5.3.0",
    "helmet": "8.3.0",
    "pino": "10.4.0",
    "pino-http": "11.0.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@minidrama/config": "workspace:*",
    "@types/cors": "2.8.19",
    "@types/express": "5.0.6",
    "@types/node": "24.19.2",
    "eslint": "10.15.0",
    "pino-pretty": "13.2.0",
    "rimraf": "6.1.4",
    "tsx": "4.23.15",
    "typescript": "6.0.3"
  }
}
