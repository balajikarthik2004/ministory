{
  "name": "@minidrama/backend",
  "version": "0.1.0",
  "private": true,
  "description": "MiniDrama API - modular monolith (Node.js + Express + TypeScript)",
  "type": "module",
  "main": "./dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.scripts.json && tsc -p tsconfig.tests.json",
    "lint": "eslint .",
    "test": "node --experimental-transform-types --disable-warning=ExperimentalWarning --import ../../tools/node-ts-resolver.mjs --test-concurrency=1 --test \"tests/**/*.test.ts\"",
    "clean": "rimraf dist .turbo",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:migrate:status": "prisma migrate status",
    "db:validate": "prisma validate",
    "db:verify": "tsx scripts/verify-schema.ts",
    "db:verify:empty": "tsx scripts/verify-schema.ts --expect-empty",
    "db:seed": "prisma db seed",
    "db:reset": "prisma migrate reset",
    "db:studio": "prisma studio",
    "retention:events": "tsx scripts/purge-playback-events.ts",
    "reconcile:deletions": "tsx scripts/reconcile-deletions.ts"
  },
  "dependencies": {
    "@minidrama/contracts": "workspace:*",
    "@node-rs/argon2": "2.0.2",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "cors": "2.8.6",
    "express": "5.3.0",
    "helmet": "8.3.0",
    "jose": "6.1.0",
    "pino": "10.4.0",
    "pino-http": "11.0.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@minidrama/config": "workspace:*",
    "@types/cors": "2.8.19",
    "@types/express": "5.0.6",
    "@types/node": "24.19.2",
    "eslint": "10.15.0",
    "pino-pretty": "13.2.0",
    "prisma": "7.10.1",
    "rimraf": "6.1.4",
    "tsx": "4.23.15",
    "typescript": "6.0.3"
  }
}
