{
  "name": "@minidrama/config",
  "version": "0.1.0",
  "private": true,
  "description": "Shared ESLint and Prettier configuration for the MiniDrama monorepo",
  "type": "module",
  "exports": {
    "./eslint/base": "./eslint/base.js",
    "./eslint/node": "./eslint/node.js",
    "./eslint/react": "./eslint/react.js",
    "./prettier": "./prettier/index.js"
  },
  "files": [
    "eslint",
    "prettier"
  ],
  "scripts": {
    "lint": "eslint .",
    "typecheck": "echo \"[@minidrama/config] no TypeScript sources\"",
    "clean": "rimraf .turbo"
  },
  "dependencies": {
    "@eslint/js": "10.0.1",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "globals": "17.14.0",
    "typescript-eslint": "8.72.2"
  },
  "devDependencies": {
    "eslint": "10.15.0",
    "rimraf": "6.1.4"
  }
}
