# Metro (Expo) does not follow pnpm's symlinked node_modules reliably.
# Hoisted linking gives Metro a flat tree it can resolve. See docs/DECISIONS.md ADR-02.
node-linker=hoisted

# Surface peer dependency problems instead of failing the install outright.
# React Native's peer graph is wide and rarely perfectly satisfiable.
strict-peer-dependencies=false
auto-install-peers=true
